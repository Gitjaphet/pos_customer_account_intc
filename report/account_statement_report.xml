<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_report_account_statement" model="ir.actions.report">
        <field name="name">Relevé de compte client (POS)</field>
        <field name="model">res.partner</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">pos_customer_account_intc.report_account_statement</field>
        <field name="report_file">pos_customer_account_intc.report_account_statement</field>
        <field name="print_report_name">'Relevé - %s' % (object.name)</field>
        <field name="binding_model_id" ref="base.model_res_partner"/>
        <field name="binding_type">report</field>
    </record>

    <template id="report_account_statement">
        <t t-call="web.html_container">
            <t t-foreach="statements" t-as="st">
                <t t-set="o" t-value="st['partner']"/>
                <t t-set="d" t-value="st['data']"/>
                <t t-call="web.external_layout">
                    <div class="page">
                        <h3>Relevé de compte</h3>
                        <p>
                            <strong t-esc="d['partner_name']"/><br/>
                            <span class="text-muted">Édité le <t t-esc="d['printed_on']"/></span>
                        </p>
                        <p t-if="not d['orders']">Aucune somme due.</p>
                        <table t-if="d['orders']" class="table table-sm o_main_table">
                            <thead>
                                <tr>
                                    <th>Date</th>
                                    <th>Ticket</th>
                                    <th class="text-end">Montant</th>
                                    <th class="text-end">Reste à payer</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-foreach="d['orders']" t-as="order">
                                    <tr>
                                        <td t-esc="order['date']"/>
                                        <td><strong t-esc="order['reference']"/></td>
                                        <td class="text-end">
                                            <span t-esc="order['amount_total']"
                                                  t-options='{"widget": "monetary", "display_currency": currency}'/>
                                        </td>
                                        <td class="text-end">
                                            <strong t-esc="order['due']"
                                                    t-options='{"widget": "monetary", "display_currency": currency}'/>
                                        </td>
                                    </tr>
                                    <t t-foreach="order['lines']" t-as="line">
                                        <tr class="text-muted small">
                                            <td/>
                                            <td>
                                                <t t-esc="'%g' % line['qty']"/> × <t t-esc="line['name']"/>
                                                <t t-foreach="line['items']" t-as="item">
                                                    <br/>· <t t-esc="item"/>
                                                </t>
                                            </td>
                                            <td class="text-end">
                                                <span t-esc="line['amount']"
                                                      t-options='{"widget": "monetary", "display_currency": currency}'/>
                                            </td>
                                            <td/>
                                        </tr>
                                    </t>
                                </t>
                            </tbody>
                            <tfoot>
                                <tr>
                                    <td colspan="3" class="text-end"><strong>Total dû</strong></td>
                                    <td class="text-end">
                                        <strong t-esc="d['total_due']"
                                                t-options='{"widget": "monetary", "display_currency": currency}'/>
                                    </td>
                                </tr>
                            </tfoot>
                        </table>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>
